# ─── Source: Directus ────────────────────────────────────────────────────────
# REST is the preferred read path. Provide a static admin token.
DIRECTUS_URL=https://cms.example.com
DIRECTUS_TOKEN=your-directus-static-admin-token

# Optional: direct DB connection. When set, enables incremental change detection
# via the directus_activity table for collections that lack a date_updated field.
# DIRECTUS_DB_URL=postgres://user:pass@host:5432/directus

# ─── Target: Lumibase ────────────────────────────────────────────────────────
LUMIBASE_URL=http://localhost:1989
LUMIBASE_SITE_ID=your-site-id
LUMIBASE_TOKEN=your-lumibase-server-token

# ─── Behavior ────────────────────────────────────────────────────────────────
SYNC_INTERVAL_MS=30000
# "*" for all user collections, or a comma-separated allowlist (e.g. articles,authors)
SYNC_COLLECTIONS=*
# Schema sync targets [Unverified] Lumibase endpoints. Keep false until confirmed.
SYNC_SCHEMA=false
SYNC_FILES=true
SYNC_FLOWS=true
SYNC_PERMISSIONS=true
# Persistent state: high-water-marks + Directus->Lumibase id-map.
STATE_FILE=./.sync-state.json
LOG_LEVEL=info
